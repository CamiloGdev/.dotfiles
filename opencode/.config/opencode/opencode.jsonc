{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "servers": {
      "notion": {
        "type": "remote",
        "url": "https://mcp.notion.com/mcp"
      },
      "linear": {
        "type": "remote",
        "url": "https://mcp.linear.app/mcp"
      },
      "newrelic_pdn": {
        "type": "remote",
        "url": "https://mcp.newrelic.com/mcp/",
        "oauth": false,
        "headers": {
          "api-key": "{env:NEW_RELIC_API_KEY}",
          "include-tags": "discovery,data-access,performance-analytics"
        }
      },
      "newrelic_qa": {
        "type": "remote",
        "url": "https://mcp.newrelic.com/mcp/",
        "oauth": false,
        "headers": {
          "api-key": "{env:NEW_RELIC_API_KEY_QA}",
          "include-tags": "discovery,data-access,performance-analytics"
        }
      },
      "playwright": {
        "type": "local",
        "command": [
          "npx",
          "-y",
          "@playwright/mcp@latest",
          "--browser",
          "chrome"
        ],
        "environment": {
          "PLAYWRIGHT_MCP_OUTPUT_DIR": "{env:HOME}/Library/Caches/playwright-mcp-output"
        },
        "timeout": {
          "startup": 60000
        }
      }
    }
  },
  "providers": {
    "openai": {
      "settings": {
        "chunkTimeout": 300000,
        "timeout": 300000
      }
    }
  }
}
