{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "newrelic_pdn": {
      "type": "remote",
      "url": "https://mcp.newrelic.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "api-key": "{env:NEW_RELIC_API_KEY}",
        "include-tags": "discovery,data-access,performance-analytics"
      }
    },
    "newrelic_qa": {
      "type": "remote",
      "url": "https://mcp.newrelic.com/mcp/",
      "enabled": true,
      "oauth": false,
      "headers": {
        "api-key": "{env:NEW_RELIC_API_KEY_QA}",
        "include-tags": "discovery,data-access,performance-analytics"
      }
    }
  },
  "provider": {
    "openai": {
      "options": {
        "headerTimeout": 300000,
        "chunkTimeout": 300000,
        "timeout": 300000
      }
    }
  }
}
